# Copy locally; never commit real values. No translator key belongs in Next.js.
NEXT_PUBLIC_STRAPI_URL=https://api.shainwaiyan.com
# Optional legacy explicit public API URL; must end in /api.
NEXT_PUBLIC_STRAPI_API_URL=
# Optional server-side override. Use the established authenticated API/proxy path.
STRAPI_API_URL=
# Read-only Content API token, never NEXT_PUBLIC_* or next.config.env.
STRAPI_API_TOKEN=
VIP_SECRET_KEY=
STRAPI_REVALIDATION_SECRET=

# Set true when embedding saved previews in Strapi Admin; then origin is required.
EDITORIAL_PREVIEW_ENABLED=false
EDITORIAL_ADMIN_ORIGIN=
RELEASE_ID=

NEXT_PUBLIC_CLOUDFLARE_WORKER_URL=https://form.shainwaiyan.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
